{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_CLAUDE_HOOKS_DISABLED:-}\" != \"1\" ] && node \"{{FORKTTY_SCRIPT}}\" hooks claude session-start || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Claude hooks",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_CLAUDE_HOOKS_DISABLED:-}\" != \"1\" ] && node \"{{FORKTTY_SCRIPT}}\" hooks claude prompt-submit || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Claude hooks",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_CLAUDE_HOOKS_DISABLED:-}\" != \"1\" ] && node \"{{FORKTTY_SCRIPT}}\" hooks claude stop || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Claude hooks",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_CLAUDE_HOOKS_DISABLED:-}\" != \"1\" ] && node \"{{FORKTTY_SCRIPT}}\" hooks claude notification || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Claude hooks",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_CLAUDE_HOOKS_DISABLED:-}\" != \"1\" ] && node \"{{FORKTTY_SCRIPT}}\" hooks claude session-end || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Claude hooks",
            "timeout": 5
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
