{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_CLAUDE_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks claude session-start || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Claude hooks",
            "timeout": 30
          }
        ],
        "matcher": "*"
      }
    ],
