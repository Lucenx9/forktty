{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini session-start || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini prompt-submit || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini pre-tool || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini post-tool || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini stop || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini notification || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini pre-compact || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${FORKTTY_GEMINI_HOOKS_DISABLED:-}\" != \"1\" ] && '{{FORKTTY_LAUNCHER}}' hooks gemini session-end || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "ForkTTY Gemini hooks",
            "timeout": 30000
          }
        ]
      }
    ]
